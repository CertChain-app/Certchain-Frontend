# Copy to .env.local and fill in. Never commit the filled-in file.

# Base URL of the CertChain API, no trailing slash. The API clients append
# their own leading slash (e.g. /users/auth/login), so a trailing one here
# produces double slashes.
# Production: https://certchain-api-525i.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origin this frontend is served from, no trailing slash. Used for absolute
# links back into the app (organizer dashboard link, /dummy.svg fallback).
# It doubles as the fallback for the two vars below when they are unset, so
# always set NEXT_PUBLIC_API_URL and NEXT_PUBLIC_ASSETS_URL explicitly.
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Base URL uploaded assets are served from (organizer logos, event images).
# Only used for relative paths; the API currently returns absolute R2 URLs.
# Production: https://pub-bde8525dccb84d869ddae0adedce2499.r2.dev
NEXT_PUBLIC_ASSETS_URL=

# Root domain for organizer subdomains, e.g. certchain.co
# Leave empty locally and on previews to skip subdomain routing entirely.
NEXT_PUBLIC_ROOT_DOMAIN=

# Guest mode: emails of the seeded demo accounts, used only to recognise a
# guest session so the dashboards can show the "browsing as a guest" banner.
# Must match GUEST_USER_EMAIL / GUEST_ORGANIZER_EMAIL on the API. Both fall
# back to these values when unset, so they are optional.
NEXT_PUBLIC_GUEST_USER_EMAIL=guest.user@certchain.demo
NEXT_PUBLIC_GUEST_ORGANIZER_EMAIL=guest.organizer@certchain.demo

# The seeded certificate that /verify offers as a working example. Must match
# SAMPLE_CERTIFICATE_ID on the API; optional, it falls back to this value.
NEXT_PUBLIC_SAMPLE_CERTIFICATE_ID=ce47a1e0-0000-4000-8000-000000000001
