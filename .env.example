# Copy to .env.local and fill in. Never commit the filled-in file.

# Base URL of the CertChain API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Fallback used when NEXT_PUBLIC_API_URL is unset
NEXT_PUBLIC_BASE_URL=

# Base URL uploaded assets are served from (organizer logos, event images)
NEXT_PUBLIC_ASSETS_URL=

# Root domain for organizer subdomains, e.g. certchain.co
# Leave empty locally and on previews to skip subdomain routing entirely.
NEXT_PUBLIC_ROOT_DOMAIN=
